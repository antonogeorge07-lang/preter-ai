{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user IDs"
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_languages": {
      "type": "string",
      "description": "JSON: {userId: langCode} per-user language prefs"
    },
    "participant_name": {
      "type": "string",
      "description": "Display name for the contact/group"
    },
    "participant_avatar": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "default": "en",
      "description": "Creator preferred language (legacy)"
    },
    "invite_code": {
      "type": "string"
    },
    "invite_open": {
      "type": "boolean",
      "default": false,
      "description": "True when this conversation has a shareable invite link; lets a non-participant add themselves via the join flow"
    },
    "last_message_preview": {
      "type": "string"
    },
    "last_message_time": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_sender_id": {
      "type": "string"
    },
    "unread_counts": {
      "type": "string",
      "description": "JSON: {userId: count}"
    },
    "typing_user_ids": {
      "type": "string",
      "description": "JSON array of currently typing user IDs"
    },
    "online_user_ids": {
      "type": "string",
      "description": "JSON array of recently-active user IDs"
    },
    "last_seen": {
      "type": "string",
      "description": "JSON: {userId: ISO timestamp}"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "muted": {
      "type": "boolean",
      "default": false
    },
    "is_group": {
      "type": "boolean",
      "default": false
    },
    "group_name": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "data.participant_ids": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "data.invite_open": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "required": []
}