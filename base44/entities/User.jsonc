{
  "name": "User",
  "type": "object",
  "properties": {
    "blocked_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user IDs this user has blocked",
      "default": []
    },
    "active_sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userAgent": {
            "type": "string"
          },
          "lastActive": {
            "type": "number"
          }
        }
      },
      "description": "Active device sessions for this user",
      "default": []
    },
    "bio": {
      "type": "string",
      "description": "Short user bio or status message"
    }
  }
}